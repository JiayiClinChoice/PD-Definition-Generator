APP_HOST=127.0.0.1
APP_PORT=8001
APP_RELOAD=true

GPT_API_URL=https://<your-resource>.services.ai.azure.com/openai/v1
GPT_API_KEY=<your-api-key>
GPT_MODEL=<your-deployment-name>

AGENT_MAX_FILE_SIZE_BYTES=52428800
AGENT_REQUEST_TIMEOUT_SECONDS=300
AGENT_MAX_RETRIES=2
AGENT_CLAIM_TIMEOUT_SECONDS=1800

# Use true behind HTTPS in production; false is for local HTTP development only.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=14
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_WINDOW_MINUTES=15
AUTH_THROTTLE_COOLDOWN_MINUTES=15
AUTH_IP_ATTEMPT_LIMIT=30

# Optional: absolute path only (leave commented to use default)
# DATABASE_PATH=D:\My Files\Python Projects\PD Definition Generator v0.1\Backend\database\app.db
